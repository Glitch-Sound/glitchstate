{
  "name": "glitchstate",
  "displayName": "GlitchState",
  "description": "状態設計のためのVS Code拡張機能",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.96.0"
  },
  "main": "./dist/extension/extension.cjs",
  "activationEvents": [
    "onCommand:glitchstate.openPreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "glitchstate.openPreview",
        "title": "GlitchState: プレビューを開く"
      }
    ],
    "languages": [
      {
        "id": "glitchstate",
        "aliases": [
          "GlitchState"
        ],
        "extensions": [
          ".gls"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "corepack pnpm build",
    "build": "corepack pnpm build:extension && corepack pnpm build:webview",
    "build:extension": "node scripts/build-extension.mjs",
    "build:webview": "vite build",
    "check:product": "corepack pnpm lint && corepack pnpm check:fsd && corepack pnpm typecheck && corepack pnpm check:docs && corepack pnpm test && corepack pnpm build && corepack pnpm test:visual && corepack pnpm test:extension",
    "check": "corepack pnpm check:product && npx --no-install openspec validate --specs --strict && node scripts/openspec-trace.mjs check && node scripts/openspec-trace.mjs generate",
    "lint": "biome check src scripts/build-extension.mjs scripts/check-doc-comments.mjs tests vite.config.ts vitest.config.ts steiger.config.ts playwright.config.ts package.json tsconfig.json biome.json",
    "check:fsd": "steiger ./src/webview",
    "check:docs": "node scripts/check-doc-comments.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:visual": "playwright test --pass-with-no-tests",
    "test:extension": "corepack pnpm build && node tests/extension/run.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@fission-ai/openspec": "^1.16.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.24.0",
    "steiger": "^0.8.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
